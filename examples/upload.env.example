# Copy to /etc/wp-backup/upload.env and chmod 600
# Used with: wp-backup.sh ... --destination both --upload-config /etc/wp-backup/upload.env

# Optional order for --destination both: PBS_THEN_S3 (default) | S3_THEN_PBS
UPLOAD_ORDER=PBS_THEN_S3

# --- Proxmox Backup Server ---
PBS_REPOSITORY=backup@pbs@pbs.example:wp-backups
# Prefer password file over inline secret:
PBS_PASSWORD_FILE=/etc/wp-backup/pbs.secret
# Or: PBS_PASSWORD=...
# Or API token as password: PBS_API_TOKEN=user@pbs!tokenid=secrettoken
# PBS_NAMESPACE=
# PBS_FINGERPRINT=
# PBS_BACKUP_ID=   # default = site-id

# --- S3 / S3-compatible ---
S3_BUCKET=wp-backups
S3_PREFIX=prod
# S3_ENDPOINT=https://minio.example:9000
S3_REGION=eu-central-1
# Credentials: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in env,
# or ~/.aws/credentials, or rclone remote (set RCLONE_REMOTE=name, default "s3")
# RCLONE_REMOTE=s3
